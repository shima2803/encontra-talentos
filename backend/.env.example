# =====================================================
# Banco de dados
# =====================================================
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/DB_Portal

# =====================================================
# App
# =====================================================
APP_NAME=Portal de Recrutamento API
APP_ENV=development
APP_DEBUG=true
FRONTEND_ORIGIN=http://localhost:3000
BANCO_TALENTOS_TITULO=Banco de Talentos
CANDIDATURA_STATUS_INICIAL=EM_ANALISE
DB_SCHEMA=public

# =====================================================
# IA (Google Gemini)
# https://aistudio.google.com -> Get API Key
# =====================================================
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true

# =====================================================
# E-mail SMTP (envio de confirmacao de candidatura)
# Para Gmail: gere uma "App Password" em myaccount.google.com/apppasswords
# =====================================================
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_app_password_de_16_caracteres
EMAIL_FROM=seu_email@gmail.com
EMAIL_FROM_NAME=Encontra Talentos
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_TIMEOUT_SECONDS=30
DB_TABLE_LOG_ENVIO_EMAIL=log_envio_email

# =====================================================
# Adzuna (https://developer.adzuna.com) - cadastro gratuito, 1k requests/mes
# Com 20 paginas x 50 vagas/pag x refresh diario = 600 calls/mes (dentro da quota)
# =====================================================
ADZUNA_APP_ID=seu_app_id_aqui
ADZUNA_APP_KEY=sua_app_key_aqui
ADZUNA_COUNTRY=br
ADZUNA_CACHE_TTL_HOURS=24
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_PAGES=20

# =====================================================
# Remotive (https://remotive.com/api/remote-jobs) - 100% gratuito, sem cadastro
# Obs: API publica limita a ~21 vagas (filtro de categoria foi desativado em 2025)
# =====================================================
REMOTIVE_ENABLED=true

# =====================================================
# Arbeitnow (https://www.arbeitnow.com/api/job-board-api) - 100% gratuito, sem cadastro
# =====================================================
ARBEITNOW_ENABLED=true

# =====================================================
# JWT - autenticacao do portal RH (empresas)
# Gere um valor aleatorio com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# =====================================================
JWT_SECRET=COLE_AQUI_UMA_STRING_ALEATORIA_LONGA_DE_PELO_MENOS_64_CARACTERES
JWT_EXPIRE_HOURS=8
